NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GOOGLE_BOOKS_API_KEY=

# Собственный PostgreSQL. Пароль подставляется только в .env.local.
DATABASE_URL=postgresql://postgres@localhost:5433/reading_tracker

# Папка для фото заметок на сервере. Лучше абсолютный путь вне проекта: её нужно сохранять в бэкапах.
PHOTOS_DIR=

# Вход через Better Auth. Приложение перейдёт на него на этапе 7, пока вход идёт через Supabase.
# Секрет: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Адрес, по которому открывается приложение.
BETTER_AUTH_URL=http://localhost:3000
# Единственный email, которому разрешён вход.
ALLOWED_EMAIL=
# Вход через Google (необязательно). Redirect URI в Google Cloud: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
