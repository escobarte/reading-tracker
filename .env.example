NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GOOGLE_BOOKS_API_KEY=

# Собственный PostgreSQL. Пароль подставляется только в .env.local.
DATABASE_URL=postgresql://postgres@localhost:5433/reading_tracker

# Папка для фото заметок на сервере. Лучше абсолютный путь вне проекта: её нужно сохранять в бэкапах.
PHOTOS_DIR=
